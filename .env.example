# Backend
PORT=4000
# Required when NODE_ENV=production - the server refuses to start without it.
# Generate one with: openssl rand -hex 32
JWT_SECRET=change_me
DATABASE_URL=postgresql://typinguser:typingpass@db:5432/typingdb
NODE_ENV=development
# Only needed when the frontend is served from a different origin than the API.
# Same-origin deploys (nginx proxying /api) can leave this empty.
# CORS_ORIGIN=https://typesprint.example.com

# Frontend
VITE_API_URL=http://localhost:4000/api
